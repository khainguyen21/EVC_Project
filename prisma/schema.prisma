// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Tutor {
  id        Int        @id @default(autoincrement())
  name      String
  type      String     // "tutor" | "professor" | "staff"
  subjects  Subject[]
  schedules Schedule[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Subject {
  id      Int    @id @default(autoincrement())
  name    String // e.g. "BIOL 020"
  field   String // e.g. "Biology"
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId Int
}

model Schedule {
  id       Int    @id @default(autoincrement())
  day      String // e.g. "Monday"
  start    String // e.g. "10:00"
  end      String // e.g. "14:00"
  location String // e.g. "SQ-231"
  tutor    Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId  Int
}

model SiteSettings {
  id                  Int      @id @default(1)
  scheduleLastUpdated DateTime @default(now())
}

// An academic term. The active one drives the homepage banner and decides
// whether "Available Now" should run at all (no shifts outside the term).
model Term {
  id        Int       @id @default(autoincrement())
  name      String    // e.g. "Fall 2026"
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  isActive  Boolean   @default(false)
  holidays  Holiday[]
  createdAt DateTime  @default(now())
}

// A day inside a term when campus tutoring is closed (Labor Day, Thanksgiving, ...).
model Holiday {
  id     Int      @id @default(autoincrement())
  name   String   // e.g. "Labor Day"
  date   DateTime @db.Date
  term   Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId Int

  @@unique([termId, date])
}
