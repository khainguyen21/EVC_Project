// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
}

model Tutor {
  id        Int        @id @default(autoincrement())
  name      String
  type      String     // "tutor" | "professor" | "staff"
  subjects  Subject[]
  schedules Schedule[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Subject {
  id      Int    @id @default(autoincrement())
  name    String // e.g. "BIOL 020"
  field   String // e.g. "Biology"
  tutor   Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId Int
}

model Schedule {
  id       Int    @id @default(autoincrement())
  day      String // e.g. "Monday"
  start    String // e.g. "10:00"
  end      String // e.g. "14:00"
  location String // e.g. "SQ-231"
  tutor    Tutor  @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  tutorId  Int
}

model SiteSettings {
  id                  Int      @id @default(1)
  scheduleLastUpdated DateTime @default(now())
  // William's usual weekly hours per tutor, for the planner's card colors.
  // Admin only: never return it from the public /api/settings. Null until he
  // sets it.
  usualWeeklyHours    Float?
}

// An academic term. The active one drives the homepage banner and decides
// whether "Available Now" should run at all (no shifts outside the term).
model Term {
  id               Int                      @id @default(autoincrement())
  name             String // e.g. "Fall 2026"
  startDate        DateTime                 @db.Date
  endDate          DateTime                 @db.Date
  isActive         Boolean                  @default(false)
  // Set while the tutor availability form is open for this term; the code is
  // the key in the link William emails. Null means the form is closed.
  availabilityCode String?                  @unique
  holidays         Holiday[]
  submissions      AvailabilitySubmission[]
  createdAt        DateTime                 @default(now())
}

// A day inside a term when campus tutoring is closed (Labor Day, Thanksgiving, ...).
model Holiday {
  id     Int      @id @default(autoincrement())
  name   String   // e.g. "Labor Day"
  date   DateTime @db.Date
  term   Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId Int

  @@unique([termId, date])
}

// A tutor's availability for a term, sent through the public form (or entered
// by an admin). It is what the tutor can do, not their schedule: approving one
// only records William's decision.
model AvailabilitySubmission {
  id            Int            @id @default(autoincrement())
  term          Term           @relation(fields: [termId], references: [id], onDelete: Cascade)
  termId        Int
  name          String
  studentId     String // 7 digits, kept as text for leading zeros
  email         String
  units         Float
  trainingDone  Boolean // finished the II 90 online tutor training
  subjectsRaw   String // exactly as the tutor typed it
  subjectCodes  String[] // parsed by utils/courseCodes, e.g. "COMSC-75"
  availability  Json // [{ day, start, end, allDay }]
  notes         String?
  status        String         @default("pending") // "pending" | "approved" | "declined"
  resubmittedAt DateTime? // last time the tutor replaced an earlier submission
  shifts        PlannedShift[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([termId, studentId])
}

// A shift William placed on the shift planner for a tutor's submission, in
// one repeating Monday-Friday week of that term. Separate from Schedule, the
// public schedule: nothing here shows publicly until it is published.
model PlannedShift {
  // Made by the browser, so undo can put back a deleted shift with its old id.
  id           String                 @id @default(uuid())
  submission   AvailabilitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId Int
  day          String // e.g. "Monday"
  building     String // e.g. "MS-112"
  start        Int // minutes after midnight, so 9:15 am is 555
  end          Int

  @@index([submissionId])
}

// One row per public form submission attempt, for per-IP rate limiting. An
// in-memory counter would reset with every serverless instance on Vercel.
model SubmissionAttempt {
  id        Int      @id @default(autoincrement())
  ipHash    String
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}
