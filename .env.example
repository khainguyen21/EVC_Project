# Copy to .env and fill in real values. Never commit .env itself.

# App runtime connection. Supabase's TRANSACTION pooler (port 6543) is right
# here: many short-lived serverless requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres"

# Prisma CLI connection (migrate, studio). Same database as DATABASE_URL, but
# the SESSION pooler on port 5432. Migrate takes a session-level advisory lock
# that the transaction pooler cannot hold, so with only DATABASE_URL set
# `prisma migrate deploy` hangs forever instead of failing.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# Admin panel login (checked in src/app/actions/auth.ts).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"

# Signs the admin session JWT. Any long random string.
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Google Gemini key for the AI schedule/email import.
GEMINI_API_KEY="your-gemini-api-key-here"
