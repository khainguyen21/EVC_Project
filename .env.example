# Copy to .env and fill in real values. Never commit .env itself.

# App runtime connection. Supabase's TRANSACTION pooler (port 6543) is right
# here: many short-lived serverless requests.
DATABASE_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:6543/postgres"

# Prisma CLI connection (migrate, studio). Same database as DATABASE_URL, but
# the SESSION pooler on port 5432. Migrate takes a session-level advisory lock
# that the transaction pooler cannot hold, so with only DATABASE_URL set
# `prisma migrate deploy` hangs forever instead of failing.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.pooler.supabase.com:5432/postgres"

# Admin panel login (checked in src/app/actions/auth.ts).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="choose-a-strong-password"

# Signs the admin session JWT. Any long random string.
SESSION_SECRET="generate-with-openssl-rand-base64-32"

# Google Gemini key for the AI schedule/email import.
GEMINI_API_KEY="your-gemini-api-key-here"

# Set to "true" only in a test database's .env. It lets `npm run db:sample`
# fill the database with made-up tutors; never set it next to the live database.
ALLOW_SAMPLE_DATA=""

# Email alerts to William when a tutor sends or updates their availability
# (src/lib/mailer.ts). Sent through the site's own Gmail account with an app
# password: Google Account > Security > 2-Step Verification > App passwords.
# Only the live site sends. Running locally, the email is printed to the
# terminal instead, so test submissions never reach William.
GMAIL_USER="site-account@gmail.com"
GMAIL_APP_PASSWORD="16-letter-app-password"
# Who gets the alerts. Several addresses can be separated by commas.
ALERT_EMAIL="coordinator@example.edu"
